{
  "name": "dsh-profile-web",
  "version": "0.0.0",
  "private": true,
  "//": "dependencies 的顺序即分组：第1组=已激活的 bundle 插件（同时列在 dsh.profile.bundles 中，由它声明的 dsh.bundle.patch 参与组合）；第2组=未激活的 bundle 插件（已安装且声明了 dsh.bundle.patch，但当前 dsh 版本有问题或暂不需要，不进 bundles）；第3组=非 bundle 包（不含 dsh.bundle 声明：CLI 二进制、库、以及靠 profile patch 的 entry 行按 name 激活的本地 workspace 插件，例如 dsh-openviking-service 由 OpenViking managed block 的 openviking-service-autostart 条目引用）。新增依赖请放进对应分组并保持组内字典序。",
  "scripts": {
    "install-services": "node ./scripts/install-services.mjs",
    "postinstall": "node ./scripts/install-services.mjs"
  },
  "dependencies": {
    "@mnemon-dev/mnemon": "^0.2.9",
    "@opendsh/dsh-plugin-setting-mcp": "^0.1.2",
    "@openviking/dsh-memory-plugin": "^0.5.8",
    "@tt-a1i/archify-dsh": "^0.1.0",
    "@xmanrui/dsh-im": "^4.28.1",
    "dsh-better-sidebar": "0.21.1",
    "dsh-coding-subscription-oauth": "^0.8.5",
    "dsh-complete-notify": "^0.6.2",
    "dsh-context": "^0.56.2",
    "dsh-find-plugin": "^0.4.0",
    "dsh-free-search": "^0.4.39",
    "dsh-llm-retry-settings": "github:Yiklek/dsh-llm-retry-settings",
    "dsh-mermaid": "^0.4.1",
    "dsh-mnemon": "^0.5.14",
    "dsh-openviking-service": "workspace:*",
    "dsh-rewind-plugin": "^0.12.2",
    "dsh-settings-manager": "github:Yiklek/dsh-settings-manager#pkg",
    "dsh-univer-office": "^0.3.5",
    "dshmarket": "^1.66.0",
    "yaml": "^2.9.1"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "dsh-settings-manager",
        "dsh-llm-retry-settings",
        "dsh-context",
        "dsh-complete-notify",
        "@tt-a1i/archify-dsh",
        "@xmanrui/dsh-im",
        "dsh-mermaid",
        "dsh-coding-subscription-oauth",
        "dsh-rewind-plugin",
        "dsh-find-plugin",
        "dsh-mnemon",
        "dshmarket",
        "dsh-univer-office",
        "dsh-free-search",
        "@deepseek-ai/dsh-experimental-agent-team-profile"
      ]
    }
  }
}
