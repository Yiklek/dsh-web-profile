thinking-effort-loaded.json

# e2e
tests/e2e/test-results/
tests/e2e/playwright-report/
.npmrc

# profile-local service data
.services/

# local backups (config snapshots and raw Session logs — never publish these)
.backups/

# plugin-manager runtime logs
.plugin-manager/
